# openai | anymodel
AI_PROVIDER=ANYMODEL

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=your_available_openai_model_here
OPENAI_REASONING_EFFORT=low

ANYMODEL_API_KEY=your_anymodel_api_key_here
ANYMODEL_BASE_URL=https://anymodel.org/v1
ANYMODEL_MODEL=cx/gpt-5.5
MESSAGE_BUFFER_MS=2000
MAX_HISTORY_MESSAGES=8
BROADCAST_DELAY_MS=1200
BROADCAST_MAX_RECIPIENTS=40
PORT=3000
DATA_DIR=/var/data
MANAGER_PHONE=77077471301
MANAGER_CHAT_ID=77077471301@c.us
SALES_MANAGER_WHATSAPP=
PRESENTATION_KP_PATH=

# Управление AI Manager из WhatsApp обычным языком. false = поведение как раньше.
MANAGEMENT_WHATSAPP_CONTROL_ENABLED=false
# Опционально: номера с правом управления. Пусто = тот же whitelist, что у менеджера.
MANAGEMENT_CONTROLLER_PHONES=
# Справочник сотрудников для «передай Асхату»: Имя:+7700...,Имя:+7700...
MANAGER_ALIASES=
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
TELEGRAM_BOT_TOKEN=
